# ---------------------------------------------------------------------------
# Local development. Copy to .env — never commit .env.
# Production values live in AWS Secrets Manager (see infra/terraform), never here.
# ---------------------------------------------------------------------------
NODE_ENV=development

DATABASE_URL=postgresql://trugrade:trugrade_dev@localhost:5442/trugrade?schema=public
DATABASE_URL_TEST=postgresql://trugrade:trugrade_dev@localhost:5442/trugrade_test?schema=public
REDIS_URL=redis://localhost:6389

S3_ENDPOINT=http://localhost:9010
S3_REGION=ap-south-1
S3_BUCKET=trugrade-dev
S3_ACCESS_KEY_ID=trugrade
S3_SECRET_ACCESS_KEY=trugrade_dev
S3_FORCE_PATH_STYLE=true

# Email OTP via SMTP. Empty SMTP_USER keeps the fake (Mailpit / logs).
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp OTP via Interakt. Empty INTERAKT_API_KEY keeps the fake (logs only).
INTERAKT_API_KEY=
INTERAKT_OTP_TEMPLATE=otp_verification

API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:3000
CONSOLE_URL=http://localhost:3001

# RS256 keypair. Generated by `pnpm dev` on first run into .keys/ (gitignored).
JWT_PRIVATE_KEY_PATH=.keys/jwt.private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt.public.pem
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
SESSION_COOKIE_DOMAIN=localhost

# Every external adapter: mock | fixture | sandbox | live. `live` throws outside production.
INTEGRATION_MODE=mock

# GSTIN Verify on /register and /sell/register. Same Zoho Books search the
# GoRefurbo buyer KYC flow uses. Leave GST_VERIFY_API_URL empty to keep the fake.
GST_VERIFY_API_URL=
GST_VERIFY_ORGANIZATION_ID=
GST_VERIFY_REFERER=
GST_VERIFY_ROLE_ID=
GST_VERIFY_CSRF_TOKEN=
GST_VERIFY_COOKIE=
GST_VERIFY_ZB_SOURCE=zbclient
GST_VERIFY_ZB_ASSET_VERSION=

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=debug
