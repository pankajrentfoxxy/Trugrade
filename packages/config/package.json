{
  "name": "@trugrade/config",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/esm/brand.js",
      "require": "./dist/brand.js",
      "default": "./dist/brand.js"
    },
    "./eslint": "./eslint/index.js",
    "./eslint/plugin": "./eslint/plugin.js",
    "./tailwind": {
      "types": "./tailwind-preset.d.ts",
      "default": "./tailwind-preset.js"
    },
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/next.json": "./tsconfig/next.json",
    "./tsconfig/react-lib.json": "./tsconfig/react-lib.json"
  },
  "files": [
    "dist",
    "eslint",
    "tsconfig",
    "tailwind-preset.js",
    "tailwind-preset.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}')\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:unit": "jest",
    "test": "jest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.1",
    "@typescript-eslint/parser": "8.46.4",
    "@typescript-eslint/rule-tester": "8.46.4",
    "jest": "30.2.0",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "typescript-eslint": "8.46.4",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0"
  }
}
