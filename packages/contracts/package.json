{
  "name": "@trugrade/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}')\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:unit": "jest",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@trugrade/config": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.1",
    "jest": "30.2.0",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3",
    "eslint": "9.39.1"
  }
}
