{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["**/.env"],
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL", "INTEGRATION_MODE"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test:unit": { "dependsOn": ["^build"] },
    "test:integration": { "dependsOn": ["^build"], "cache": false },
    "test:e2e": { "cache": false },
    "test": { "dependsOn": ["test:unit"] },
    "dev": { "cache": false, "persistent": true }
  }
}
