{
  "name": "@trugrade/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "jest --config jest.unit.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test": "jest --config jest.unit.config.js",
    "db:migrate": "prisma migrate deploy",
    "db:introspect": "prisma db pull && prisma generate",
    "db:generate": "prisma generate",
    "db:reset": "node scripts/reset-db.mjs",
    "db:seed": "ts-node -T --project tsconfig.json prisma/seed/index.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/terminus": "11.0.0",
    "@prisma/client": "6.16.3",
    "@trugrade/config": "workspace:*",
    "@trugrade/contracts": "workspace:*",
    "argon2": "0.44.0",
    "bullmq": "5.63.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "otplib": "12.0.1",
    "pino": "9.13.1",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.8",
    "@nestjs/testing": "11.1.6",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.1",
    "@types/supertest": "6.0.3",
    "jest": "30.2.0",
    "prisma": "6.16.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
