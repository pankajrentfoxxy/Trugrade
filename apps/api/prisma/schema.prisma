generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["catalog", "customer", "identity", "kyc", "listing", "logistics", "ops", "ordering", "payment", "platform", "procurement", "public", "qc", "vendor"]
}

model brand {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @unique
  slug              String              @unique
  logo_key          String?
  is_active         Boolean             @default(true)
  series            series[]
  vendor_capability vendor_capability[]

  @@schema("catalog")
}

model catalog_change_log {
  id           BigInt        @id @default(autoincrement())
  sku_id       String        @db.Uuid
  field        String
  old_value    String?
  new_value    String?
  changed_by   String?       @db.Uuid
  changed_at   DateTime      @default(now()) @db.Timestamptz(6)
  user_account user_account? @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sku          sku           @relation(fields: [sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model model {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  series_id    String   @db.Uuid
  name         String
  model_year   Int?
  form_factor  String?
  msrp_new_inr Decimal? @db.Decimal(14, 2)
  description  String?
  is_active    Boolean  @default(true)
  series       series   @relation(fields: [series_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sku          sku[]

  @@unique([series_id, name])
  @@schema("catalog")
}

model series {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id  String  @db.Uuid
  name      String
  slug      String
  is_active Boolean @default(true)
  model     model[]
  brand     brand   @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([brand_id, name])
  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model sku {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_id           String               @db.Uuid
  sku_code           String               @unique
  normalized_key     String               @unique
  cpu_brand          String
  cpu_family         String
  cpu_model          String
  cpu_generation     String
  cores              Int?
  threads            Int?
  ram_gb             Int
  ram_type           String?
  ram_upgradable_to  Int?
  storage_type       String
  storage_gb         Int
  gpu_type           String
  gpu_model          String?
  screen_size_inch   Decimal              @db.Decimal(4, 1)
  resolution         String
  panel_type         String?
  is_touch           Boolean              @default(false)
  os_supported       String
  ports_json         Json?
  weight_kg          Decimal?             @db.Decimal(5, 2)
  battery_wh         Int?
  charger_watt       Int?
  hsn_code           String               @default("8471")
  gst_rate           Decimal              @default(18.00) @db.Decimal(5, 2)
  version            Int                  @default(1)
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  created_by         String?              @db.Uuid
  catalog_change_log catalog_change_log[]
  user_account       user_account?        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  model              model                @relation(fields: [model_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sku_image          sku_image[]
  sku_request        sku_request[]
  listing            listing[]
  unit               unit[]
  order_line         order_line[]
  rfq                rfq[]
  invoice_line       invoice_line[]

  @@index([cpu_generation, ram_gb, storage_gb], map: "ix_sku_filter")
  @@index([ports_json], map: "ix_sku_ports", type: Gin)
  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sku_image {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku_id     String @db.Uuid
  file_key   String
  image_type String
  sort_order Int    @default(0)
  sku        sku    @relation(fields: [sku_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sku_request {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_org_id   String        @db.Uuid
  raw_brand       String
  raw_model       String
  raw_config      String
  spec_url        String?
  photo_key       String?
  status          String        @default("PENDING")
  resolved_sku_id String?       @db.Uuid
  resolved_by     String?       @db.Uuid
  resolved_at     DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  user_account    user_account? @relation(fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sku             sku?          @relation(fields: [resolved_sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization    organization  @relation(fields: [vendor_org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, created_at], map: "ix_skureq_queue")
  @@schema("catalog")
}

