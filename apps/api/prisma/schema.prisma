  org_id             String?            @db.Uuid
  entity_type        String
  value_hash         String
  blacklist_entry_id String             @db.Uuid
  checked_at         DateTime           @default(now()) @db.Timestamptz(6)
  stage              String
  blacklist_entry    blacklist_entry    @relation(fields: [blacklist_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registration_lead  registration_lead? @relation(fields: [lead_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization       organization?      @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([org_id, checked_at(sort: Desc)], map: "ix_blacklist_hit_org")
  @@schema("kyc")
}

